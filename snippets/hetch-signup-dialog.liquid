{%- comment -%} Lab89: dialog opened by the header "Get £5 off" button. Re-opens after submit to show the code. {%- endcomment -%}
<dialog id="HetchSignupDialog" class="hetch-signup-dialog" aria-label="Get £5 off">
  <button type="button" class="hetch-signup-dialog__close" aria-label="Close" onclick="this.closest('dialog').close()">&times;</button>
  {%- render 'hetch-signup-form', form_id: 'HetchSignupHeader', compact: false, source: 'header' -%}
</dialog>
<style>
  .hetch-signup-dialog{border:0;border-radius:16px;padding:32px 28px 24px;width:min(460px,calc(100vw - 32px));box-shadow:0 20px 60px rgba(0,0,0,.25)}
  .hetch-signup-dialog::backdrop{background:rgba(31,42,68,.55)}
  .hetch-signup-dialog__close{position:absolute;top:10px;right:14px;background:none;border:0;font-size:28px;line-height:1;cursor:pointer;color:#1F2A44}
  .hetch-signup-trigger{display:inline-flex;align-items:center;height:36px;padding:0 16px;border:1.5px solid currentColor;border-radius:30px;background:transparent;color:inherit;font:inherit;font-size:14px;font-weight:500;cursor:pointer;white-space:nowrap}
  .hetch-signup-trigger:hover{background:#1F2A44;color:#fff;border-color:#1F2A44}
  @media (max-width:749px){.hetch-signup-trigger{height:30px;padding:0 10px;font-size:12px}}
</style>
<script>
  (function(){
    var d=document.getElementById('HetchSignupDialog'); if(!d||!d.showModal) return;
    document.addEventListener('click',function(e){var t=e.target.closest('[data-hetch-signup-open]'); if(t){e.preventDefault(); d.showModal();}});
    var f=d.querySelector('form'); if(f){f.addEventListener('submit',function(){try{sessionStorage.setItem('hetchSignupOpen','1')}catch(e){}});}
    try{ if(sessionStorage.getItem('hetchSignupOpen')==='1' && /customer_posted=true|contact_posted=true|#contact_form/.test(location.href+location.hash) || (sessionStorage.getItem('hetchSignupOpen')==='1' && d.querySelector('.hetch-signup__error'))){ sessionStorage.removeItem('hetchSignupOpen'); d.showModal(); } }catch(e){}
  })();
</script>
