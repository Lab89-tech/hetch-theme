{%- comment -%} Lab89: slim trust strip (icon + text), editable per market in the customizer. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="hetch-trust" style="--ht-bg:{{ section.settings.background }};--ht-fg:{{ section.settings.text_color }}">
  <ul class="hetch-trust__list">
    {%- for block in section.blocks -%}
      <li class="hetch-trust__item" {{ block.shopify_attributes }}>
        <span class="hetch-trust__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'van' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7"/><circle cx="6" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/></svg>
            {%- when 'house' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 11l9-7 9 7"/><path d="M6 9.5V20h12V9.5"/></svg>
            {%- when 'chat' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5h16v11H9l-4 3v-3H4z"/></svg>
            {%- when 'shield' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3v5M15 3v5M7 8h10v4a5 5 0 01-10 0zM12 17v4"/></svg>
          {%- endcase -%}
        </span>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
<style>
  .hetch-trust{background:var(--ht-bg);color:var(--ht-fg);border-bottom:1px solid rgba(0,0,0,.12)}
  .hetch-trust__list{display:flex;justify-content:space-around;align-items:center;gap:16px;max-width:1400px;margin:0 auto;padding:14px 16px;list-style:none}
  .hetch-trust__item{display:flex;align-items:center;gap:10px;font-weight:500;font-size:15px;white-space:nowrap}
  .hetch-trust__item a{color:inherit;text-decoration:none}
  .hetch-trust__icon{display:inline-flex}
  @media (max-width:749px){
    .hetch-trust__list{justify-content:flex-start;overflow-x:auto;scrollbar-width:none;padding:10px 16px;gap:24px}
    .hetch-trust__list::-webkit-scrollbar{display:none}
    .hetch-trust__item{font-size:13px}
  }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Trust strip",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1F2A44" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "van", "options": [
          { "value": "van", "label": "Van" }, { "value": "house", "label": "House" }, { "value": "chat", "label": "Chat" },
          { "value": "shield", "label": "Shield" }, { "value": "plug", "label": "Plug" } ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Trust strip", "blocks": [ { "type": "item" } ] } ]
}
{% endschema %}
